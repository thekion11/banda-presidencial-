; Engine configuration file.
config_version=5

[application]

config/quit_on_go_back=false
config/name="Presidente de Chile"
config/version="0.9.0-prueba1"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://game/main.tscn"
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.133, 0.208, 1)
boot_splash/image="res://game/arte/marca/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[gui]

theme/custom_font="res://game/fuentes/Inter.ttf"
