{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 20,
  "items": {
    "type": "object",
    "required": [
      "id",
      "categoria",
      "costo_pa",
      "titulo",
      "efectos",
      "requisitos",
      "corrector",
      "abre_propuesta_comite",
      "fuente"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "categoria": {
        "type": "string"
      },
      "costo_pa": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "titulo": {
        "type": "string",
        "maxLength": 60
      },
      "efectos": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "ind",
            "delta"
          ],
          "additionalProperties": false,
          "properties": {
            "ind": {
              "enum": [
                "aprobacion",
                "capital",
                "cohesion",
                "fiscal",
                "riesgo_ejecucion",
                "viviendas_anio"
              ]
            },
            "delta": {
              "type": "number"
            }
          }
        }
      },
      "requisitos": {
        "type": "object",
        "required": [
          "ley",
          "quorum"
        ]
      },
      "corrector": {
        "type": [
          "object",
          "null"
        ],
        "required": [],
        "properties": {
          "meta": {
            "type": "number"
          },
          "capacidad": {
            "type": "number"
          },
          "capacidad_ind": {
            "enum": [
              "aprobacion",
              "capital",
              "cohesion",
              "fiscal",
              "riesgo_ejecucion",
              "viviendas_anio"
            ]
          },
          "modo": {
            "enum": [
              "version_viable",
              "por_tramos"
            ]
          }
        }
      },
      "abre_propuesta_comite": {
        "type": [
          "string",
          "null"
        ]
      },
      "obra": {
        "type": "object",
        "required": [
          "nombre",
          "dias_totales"
        ]
      },
      "fuente": {
        "type": "string",
        "pattern": "^fuentes\\.json#[a-z0-9_]+$"
      }
    }
  }
}