{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 20,
  "items": {
    "type": "object",
    "required": [
      "id",
      "categoria",
      "costo_pa",
      "titulo",
      "efectos",
      "requisitos",
      "corrector",
      "abre_propuesta_comite",
      "fuente"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "categoria": {
        "type": "string"
      },
      "costo_pa": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "titulo": {
        "type": "string",
        "maxLength": 60
      },
      "efectos": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "ind",
            "delta"
          ],
          "additionalProperties": false,
          "properties": {
            "ind": {
              "enum": [
                "aprobacion",
                "capital",
                "cohesion",
                "fiscal",
                "riesgo_ejecucion",
                "viviendas_anio",
                "rival"
              ]
            },
            "delta": {
              "type": "number"
            }
          }
        }
      },
      "requisitos": {
        "type": "object",
        "required": [
          "ley",
          "quorum"
        ]
      },
      "corrector": {
        "type": [
          "object",
          "null"
        ],
        "required": [],
        "properties": {
          "meta": {
            "type": "number"
          },
          "capacidad": {
            "type": "number"
          },
          "capacidad_ind": {
            "enum": [
              "aprobacion",
              "capital",
              "cohesion",
              "fiscal",
              "riesgo_ejecucion",
              "viviendas_anio",
                "rival"
            ]
          },
          "modo": {
            "enum": [
              "version_viable",
              "por_tramos"
            ]
          }
        }
      },
      "abre_propuesta_comite": {
        "type": [
          "string",
          "null"
        ]
      },
      "obra": {
        "type": "object",
        "required": [
          "nombre",
          "dias_totales"
        ]
      },
      "fuente": {
        "type": "string",
        "pattern": "^fuentes\\.json#[a-z0-9_]+$"
      },
      "disponibilidad": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "anio_desde": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "anio_hasta": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "evento": {
            "type": [
              "string",
              "null"
            ]
          },
          "fiscal_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "meta": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^meta_[a-z]+_[1-3]$"
          }
        }
      },
      "arte": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$",
        "description": "Ilustración específica game/arte/cartas/<arte>.jpg; si falta el archivo se usa la de la categoría."
      }
    }
  }
}
