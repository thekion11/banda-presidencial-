{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "tipo",
      "dia_objetivo",
      "hora_etiqueta",
      "peso_sorteo",
      "titulo",
      "descripcion",
      "votacion",
      "efectos_base",
      "fuente"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "tipo": {
        "enum": [
          "programado",
          "aleatorio_semilla",
          "cadena"
        ]
      },
      "dia_objetivo": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hora_etiqueta": {
        "type": "string",
        "pattern": "^\\d{2}:\\d{2}$"
      },
      "peso_sorteo": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "etapa": {
        "enum": [
          "campana",
          "gobierno",
          "oposicion"
        ]
      },
      "efectos_base": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ind",
            "delta"
          ],
          "additionalProperties": false,
          "properties": {
            "ind": {
              "enum": [
                "aprobacion",
                "capital",
                "cohesion",
                "fiscal",
                "riesgo_ejecucion",
                "viviendas_anio",
                "rival"
              ]
            },
            "delta": {
              "type": "number"
            }
          }
        }
      },
      "fuente": {
        "type": "string",
        "pattern": "^fuentes\\.json#[a-z0-9_]+$"
      }
    }
  }
}