{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "institucion",
      "titulo",
      "url",
      "fecha_corte",
      "vigencia_dias",
      "es_ilustrativa"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "institucion": {
        "type": "string"
      },
      "titulo": {
        "type": "string"
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "fecha_corte": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "vigencia_dias": {
        "type": "integer",
        "minimum": 1
      },
      "es_ilustrativa": {
        "type": "boolean"
      },
      "verificado_contra_texto": {
        "type": "boolean"
      }
    }
  }
}